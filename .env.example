# Copy to .env and fill in. Variables are validated in src/env.js — the app refuses to start with
# missing or malformed values.

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=finfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finfolio
# Used by `bun run dev` and drizzle-kit on the host. Inside compose the app gets its own URL.
DATABASE_URL=postgres://finfolio:change-me@localhost:5432/finfolio

# ── Auth ─────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL people use to reach the app (your Cloudflare hostname in production).
BETTER_AUTH_URL=http://localhost:3000
# Required only to create the first admin. Generate separately: openssl rand -base64 32
# Enter this token on /setup, then remove it from .env after setup and restart.
SETUP_TOKEN=
# Force every user to set up an authenticator app before using the app.
REQUIRE_TWO_FACTOR=true

# ── Secrets at rest ──────────────────────────────────────────────────────────
# Encrypts stored API keys. openssl rand -base64 32 — do not change it after keys are saved.
APP_ENCRYPTION_KEY=

# ── Defaults ─────────────────────────────────────────────────────────────────
# Built-in preset pack for brokers, banks, categories and currencies (see src/presets).
# The sg pack also turns on CPF and SRS accounts.
DATA_PRESET=sg
# Or supply your own pack as JSON (validated against src/presets/types.ts). Add
# "features": { "cpfSrs": true } to it to keep CPF and SRS.
# PRESET_FILE=/app/config/preset.json

# ── opencode ─────────────────────────────────────────────────────────────────
OPENCODE_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=change-me-too
OPENCODE_DEFAULT_MODEL=opencode-go/glm-5.3-flash
# Version of opencode the compose server installs; keep it in step with @opencode-ai/sdk.
# OPENCODE_VERSION=1.19.3
# Host path to the auth.json created by `opencode auth login`.
# OPENCODE_AUTH_FILE=/home/you/.local/share/opencode/auth.json

# ── Email (optional) ─────────────────────────────────────────────────────────
# Lets the admin console email invite and reset links, and warn people about sign-ins from new
# devices. Without it, links are shown to the admin to hand over.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM="Finfolio <finfolio@example.com>"

# ── Backups ──────────────────────────────────────────────────────────────────
# The compose `backup` service writes nightly dumps here; Admin → Data lists them and can ask for
# one now. Days to keep dumps for (read by both the backup service and the admin console).
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14

# ── Optional ─────────────────────────────────────────────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=
